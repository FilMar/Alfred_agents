# Mosè — Third Identity rule recipes.
# This skill wraps the underlying identity CLI. SKILL.md references only these
# recipes; it never invokes the CLI directly.
#
# Positional args only. Fixed-arity recipes start with scripts/guard.sh,
# which rejects flag-style (--x) and NAME=value invocations: just would
# silently map them into positional slots and corrupt the call.

set positional-arguments

guard := justfile_directory() / "scripts/guard.sh"

default:
    @just --list

# Search existing rules. Drops results below min_score. Usage: just search "<query>" [limit] [min_score]
search query limit="5" min_score="0.6":
    @"{{guard}}" 'Usage: just search "<query>" [limit] [min_score]' "$@"
    @ti search "$1" --limit "$2" --min-score "$3"

# List rules, optionally filtered by tags. Usage: just list ["tag1,tag2"]
list tags="":
    #!/usr/bin/env bash
    set -euo pipefail
    "{{guard}}" 'Usage: just list ["tag1,tag2"]' "$@"
    args=()
    IFS=',' read -ra ts <<< "${1:-}"
    for t in "${ts[@]}"; do
        t="$(printf '%s' "$t" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [ -n "$t" ] && args+=(--tags "$t")
    done
    exec ti list "${args[@]}"

# Add a new rule. Usage: just add "<context>" "<action>" ["tag1,tag2"]
add context action tags="":
    #!/usr/bin/env bash
    set -euo pipefail
    "{{guard}}" 'Usage: just add "<context>" "<action>" ["tag1,tag2"]' "$@"
    args=(--if "$1" --do "$2")
    IFS=',' read -ra ts <<< "${3:-}"
    for t in "${ts[@]}"; do
        t="$(printf '%s' "$t" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [ -n "$t" ] && args+=(--tags "$t")
    done
    exec ti add "${args[@]}"

# Append a second action to an existing rule by id. Usage: just append-do <id> "<new action>"
append-do id action:
    @"{{guard}}" 'Usage: just append-do <id> "<new action>"' "$@"
    @ti append-do "$1" --do "$2"

# Browse Third Brain notes of a given kind (used when distilling from TB). Usage: just tb-browse <kind> [limit]
tb-browse kind limit="50":
    @"{{guard}}" 'Usage: just tb-browse <kind> [limit]' "$@"
    @tb browse --kind "$1" --limit "$2"
