[Unit]
Description=Clio Backup - Qdrant to MEGA
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/just -f /home/filippo/.pi/agent/skills/clio/justfile clio-backup-all
WorkingDirectory=/home/filippo
Environment=PATH=/usr/bin:/bin:/usr/sbin:/sbin

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clio-backup

[Install]
WantedBy=default.target
