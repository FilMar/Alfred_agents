# Atlante: interactive HTML charts with D3.js
# Usage: just -f ~/.pi/agent/skills/atlante/justfile <recipe> [args...]
#
# Recipes run in the caller's directory, so OUTPUT is relative to where
# you are, not to this skill folder.
#
# Every argument goes through quote(), so titles and labels may contain
# spaces and apostrophes.
#
# Look and feel (colors, size, node radius, legend, value labels) is not
# exposed here on purpose. It all lives in config.js.

gen := justfile_directory()

# Bar chart. DATA and LABELS are JSON arrays of the same length.
[no-cd]
bar DATA LABELS OUTPUT="schema.html" TITLE="Bar Chart":
    bun {{gen}}/schema-bar.js --data {{quote(DATA)}} --labels {{quote(LABELS)}} --output {{quote(OUTPUT)}} --title {{quote(TITLE)}}

# Pie chart. DATA and LABELS are JSON arrays of the same length.
[no-cd]
pie DATA LABELS OUTPUT="schema.html" TITLE="Pie Chart":
    bun {{gen}}/schema-pie.js --data {{quote(DATA)}} --labels {{quote(LABELS)}} --output {{quote(OUTPUT)}} --title {{quote(TITLE)}}

# Donut chart. Same data as pie, with a hole in the middle.
[no-cd]
donut DATA LABELS OUTPUT="schema.html" TITLE="Donut Chart":
    bun {{gen}}/schema-pie.js --data {{quote(DATA)}} --labels {{quote(LABELS)}} --donut true --output {{quote(OUTPUT)}} --title {{quote(TITLE)}}

# Scatter plot. DATA is a JSON array of [x, y] pairs.
[no-cd]
scatter DATA OUTPUT="schema.html" TITLE="Scatter Plot" XLABEL="X" YLABEL="Y":
    bun {{gen}}/schema-xy.js --data {{quote(DATA)}} --output {{quote(OUTPUT)}} --title {{quote(TITLE)}} --xlabel {{quote(XLABEL)}} --ylabel {{quote(YLABEL)}}

# Line chart. DATA is a JSON array of [x, y] pairs, drawn in order.
[no-cd]
line DATA OUTPUT="schema.html" TITLE="Line Chart" XLABEL="X" YLABEL="Y":
    bun {{gen}}/schema-xy.js --data {{quote(DATA)}} --line true --output {{quote(OUTPUT)}} --title {{quote(TITLE)}} --xlabel {{quote(XLABEL)}} --ylabel {{quote(YLABEL)}}

# Tree chart. DATA is a nested JSON object of label and children.
[no-cd]
tree DATA OUTPUT="schema.html" TITLE="Tree":
    bun {{gen}}/schema-tree.js --data {{quote(DATA)}} --output {{quote(OUTPUT)}} --title {{quote(TITLE)}}

# Force-directed graph. NODES and LINKS are JSON arrays.
[no-cd]
force NODES LINKS OUTPUT="schema.html" TITLE="Force Graph":
    bun {{gen}}/schema-force.js --nodes {{quote(NODES)}} --links {{quote(LINKS)}} --output {{quote(OUTPUT)}} --title {{quote(TITLE)}}

# Open a generated chart in the browser.
[no-cd]
open FILE="schema.html":
    xdg-open {{quote(FILE)}}
