# Aristotele — Third Brain structural recipes.
# This skill wraps the underlying memory CLI. SKILL.md references only these
# recipes; it never invokes the CLI directly.
#
# Positional args only. Fixed-arity recipes start with scripts/guard.sh,
# which rejects flag-style (--x) and NAME=value invocations: just would
# silently map them into positional slots and corrupt the call.
# There is deliberately no recipe to change a note's kind: kind is immutable.

set positional-arguments

guard := justfile_directory() / "scripts/guard.sh"

default:
    @just --list

# Search the Third Brain. Usage: just search "<query>" [limit] [depth]
search query limit="10" depth="1":
    @"{{guard}}" 'Usage: just search "<query>" [limit] [depth]' "$@"
    @tb search "$1" --limit "$2" --depth "$3"

# Deep cluster scan: depth-2 search including hub notes. Usage: just map "<query>" [limit]
map query limit="10":
    @"{{guard}}" 'Usage: just map "<query>" [limit]' "$@"
    @tb search "$1" --limit "$2" --depth 2 --include-hubs

# Browse notes by kind. Usage: just browse <kind> [limit] ["<ISO date>"]
browse kind limit="20" since="":
    #!/usr/bin/env bash
    set -euo pipefail
    "{{guard}}" 'Usage: just browse <kind> [limit] ["<ISO date>"]' "$@"
    args=(--kind "$1" --limit "$2")
    [ -n "${3:-}" ] && args+=(--since "$3")
    exec tb browse "${args[@]}"

# List tags by frequency.
tags:
    @tb tags

# Open the graph visualisation in the browser.
graph:
    @tb graph

# Save a new note (hub or synthesis). Usage: just save "<what>" "<why>" <kind> ["tag1,tag2"] ["<source>"]
save what why kind tags="" source="":
    #!/usr/bin/env bash
    set -euo pipefail
    "{{guard}}" 'Usage: just save "<what>" "<why>" <kind> ["tag1,tag2"] ["<source>"]' "$@"
    args=(--what "$1" --why "$2" --kind "$3")
    IFS=',' read -ra ts <<< "${4:-}"
    for t in "${ts[@]}"; do
        t="$(printf '%s' "$t" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [ -n "$t" ] && args+=(--tags "$t")
    done
    [ -n "${5:-}" ] && args+=(--source "$5")
    exec tb save "${args[@]}"

# Add a ref to a note. Usage: just add-ref <id> "<target-id>:<reason>"
add-ref id ref:
    @"{{guard}}" 'Usage: just add-ref <id> "<target-id>:<reason>"' "$@"
    @tb update "$1" --add-ref "$2"
