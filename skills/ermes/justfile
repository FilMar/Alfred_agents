# Himalaya CLI wrapper for the ermes skill.
# Accounts: "filippo" (default) and "lavoro" — pass the account name as the
# first positional argument to target the other one.
#
# Positional args only. Fixed-arity recipes start with scripts/guard.sh,
# which rejects flag-style (--x) and NAME=value invocations: just would
# silently map them into positional slots and corrupt the call.

set positional-arguments

guard := justfile_directory() / "scripts/guard.sh"

default:
    @just --list

# List configured accounts
accounts:
    himalaya account list --json

# List available folders
folders account="filippo":
    @"{{guard}}" 'Usage: just folders [account]' "$@"
    himalaya mailbox list --json -a {{account}}

# List envelopes in INBOX (or given folder)
inbox account="filippo" folder="INBOX" page="200":
    @"{{guard}}" 'Usage: just inbox [account] [folder] [page-size]' "$@"
    himalaya envelope list --page-size {{page}} --json -m {{folder}} -a {{account}}

# Search using Himalaya's query syntax (e.g. 'from paypal and after 2026-01-01')
search account="filippo" folder="INBOX" *query:
    himalaya envelope search --json -m {{folder}} -a {{account}} {{query}}

# Read a message body (marks it "seen" automatically)
read account id folder="INBOX":
    @"{{guard}}" 'Usage: just read <account> <id> [folder]' "$@"
    himalaya message read {{id}} -m {{folder}} -a {{account}}

# Read a message without marking it as read (himalaya v2 dropped --preview:
# read it, then restore "unseen" — if it was already "seen" before, it stays "seen")
preview account id folder="INBOX":
    #!/usr/bin/env bash
    set -euo pipefail
    "{{guard}}" 'Usage: just preview <account> <id> [folder]' "$@"
    himalaya message read {{id}} -m {{folder}} -a {{account}}
    himalaya flag remove -f seen {{id}} -m {{folder}} -a {{account}}

# Print the raw RFC 5322 message (useful for links lost in the text rendering;
# himalaya v2 dropped the export command for just text/html)
html account id folder="INBOX":
    @"{{guard}}" 'Usage: just html <account> <id> [folder]' "$@"
    himalaya message read {{id}} -m {{folder}} -a {{account}} --raw

# Add a flag (e.g. seen, flagged, answered) to one or more ids
flag-add account folder flag *ids:
    himalaya flag add -f {{flag}} {{ids}} -m {{folder}} -a {{account}}

# Remove a flag from one or more ids
flag-remove account folder flag *ids:
    himalaya flag remove -f {{flag}} {{ids}} -m {{folder}} -a {{account}}

# Tag recipes. A tag is a custom IMAP keyword stored on the server.
# The shared `flag` API above only accepts the four system flags, so tags
# use the raw IMAP API instead. Two quirks of that API:
#   - `--` before the ids is required: -f is variadic and eats them otherwise.
#   - the ids are one IMAP sequence set, so they join with commas, not spaces.

# Add a tag to one or more ids
tag-add account folder tag *ids:
    #!/usr/bin/env bash
    set -euo pipefail
    seq=$(echo "{{ids}}" | tr -s ' ' ',')
    himalaya imap store -a {{account}} -m {{folder}} -f '{{tag}}' -- "$seq"

# Remove a tag from one or more ids
tag-rm account folder tag *ids:
    #!/usr/bin/env bash
    set -euo pipefail
    seq=$(echo "{{ids}}" | tr -s ' ' ',')
    himalaya imap store -a {{account}} -m {{folder}} --action remove -f '{{tag}}' -- "$seq"

# List envelopes carrying a tag
tag-find account tag folder="INBOX":
    @"{{guard}}" 'Usage: just tag-find <account> <tag> [folder]' "$@"
    himalaya envelope search --json -m {{folder}} -a {{account}} flag '{{tag}}'

# List every tag the folder already holds (the tag vocabulary)
tags account folder="INBOX":
    @"{{guard}}" 'Usage: just tags <account> [folder]' "$@"
    himalaya imap flags -a {{account}} {{folder}}

# Download one or more attachments of a single message (omit ids to download all)
download account folder id *attachment_ids:
    himalaya attachment download {{id}} {{attachment_ids}} -m {{folder}} -a {{account}}

# Move one or more ids from a source folder to a destination folder
# (the destination folder must already exist: himalaya v2 dropped the command to create one)
move account src dst *ids:
    himalaya message move --from '{{src}}' --to '{{dst}}' {{ids}} -a {{account}}

# Generate a reply template for an id and save it to ~/mail/outbox/
reply account id folder="INBOX":
    #!/usr/bin/env bash
    set -euo pipefail
    "{{guard}}" 'Usage: just reply <account> <id> [folder]' "$@"
    mkdir -p ~/mail/outbox
    file=~/mail/outbox/reply-{{id}}.eml
    himalaya message reply {{id}} -m {{folder}} -a {{account}} > "$file"
    echo "Template saved: $file"

# Generate a template for a new message (From/signature prefilled by himalaya) and save it to ~/mail/outbox/
template account to subject body:
    #!/usr/bin/env bash
    set -euo pipefail
    "{{guard}}" 'Usage: just template <account> <to> "<subject>" "<body>"' "$@"
    mkdir -p ~/mail/outbox
    slug=$(echo "{{subject}}" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//')
    file=~/mail/outbox/"$slug".eml
    himalaya message compose -a {{account}} -t '{{to}}' -s '{{subject}}' --body '{{body}}' > "$file"
    echo "Template saved: $file"

# Print (does NOT run) the command the user can use to send a template
send-cmd file account="filippo":
    @"{{guard}}" 'Usage: just send-cmd <file> [account]' "$@"
    @echo "himalaya message send -a {{account}} -- {{file}}"

# Print the content of a template already saved in outbox
show-template file:
    @"{{guard}}" 'Usage: just show-template <file>' "$@"
    @cat {{file}}

# Third Identity recipes for mail triage rules.

# Search existing triage rules for a sender.
ti-search sender:
    @"{{guard}}" 'Usage: just ti-search "<sender address or domain>"' "$@"
    ti search "{{sender}}" --tags mail --tags triage --limit 1

# Add a triage rule that tags mail from a sender.
ti-add sender tag:
    @"{{guard}}" 'Usage: just ti-add "<sender address or domain>" "<tag>"' "$@"
    ti add --if "{{sender}}" --do "tag with {{tag}}" --tags mail --tags triage

# List all mail triage rules.
ti-list:
    ti list --tags mail --tags triage

# Delete a stale triage rule by id.
ti-delete id:
    @"{{guard}}" 'Usage: just ti-delete <id>' "$@"
    ti delete {{id}}
