# Gardener — memory cultivation recipes.
# This skill wraps the underlying memory CLIs. SKILL.md references only these
# recipes; it never invokes the CLIs directly.

default:
    @just --list

# Search the Third Brain.
search query *FLAGS:
    tb search "{{query}}" {{FLAGS}}

# List tags by frequency.
tags:
    tb tags

# Save a new note.
save what why kind *FLAGS:
    tb save --what "{{what}}" --why "{{why}}" --kind {{kind}} {{FLAGS}}

# Update an existing note (tags, refs, etc.).
update id *FLAGS:
    tb update {{id}} {{FLAGS}}

# Return a random note for serendipity bridges.
random:
    tb random

# Add a procedural rule to Third Identity.
ti-add context action *FLAGS:
    ti add --if "{{context}}" --do "{{action}}" {{FLAGS}}
