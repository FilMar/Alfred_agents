# GitHub management for Emotion-SRL / SVILUPPO project.
# All operations go through these recipes — the skill never calls gh directly.
# Run `just --list` from this directory to see all recipes.

ORG := "Emotion-SRL"
PROJECT_NUM := "4"
PROJECT_ID := "PVT_kwDOBGn_Wc4BZ0Ec"
STATUS_FIELD := "PVTSSF_lADOBGn_Wc4BZ0EczhUwJEU"
SIZE_FIELD := "PVTSSF_lADOBGn_Wc4BZ0EczhUwJRk"
SCRIPTS := justfile_directory() / "scripts"

default:
    @just --list

# === ISSUES ===

# Create an issue and add it to SVILUPPO (status=Backlog)
# Usage: just issue-create server_api "Fix invoice calculation"
issue-create repo title:
    #!/usr/bin/env bash
    set -euo pipefail
    URL=$(gh issue create --repo Emotion-SRL/{{repo}} --title '{{title}}')
    echo "Issue created: $URL"
    ITEM_ID=$(gh project item-add 4 --owner Emotion-SRL --url "$URL" --format json -q .id 2>/dev/null || echo "")
    if [ -n "$ITEM_ID" ]; then
        gh project item-edit --id "$ITEM_ID" --project-id PVT_kwDOBGn_Wc4BZ0Ec \
            --field-id PVTSSF_lADOBGn_Wc4BZ0EczhUwJEU \
            --single-select-option-id f75ad846 2>/dev/null
        echo "Added to SVILUPPO (Backlog). Item ID: $ITEM_ID"
    else
        echo "Warning: issue created but could not add to SVILUPPO."
        echo "Add manually with: just proj-add {{repo}} <issue-number>"
    fi

# Create an issue with body and add it to SVILUPPO (status=Backlog)
# Usage: just issue-create-body server_api "Fix invoice" "The calculation is wrong when..."
issue-create-body repo title body:
    #!/usr/bin/env bash
    set -euo pipefail
    URL=$(gh issue create --repo Emotion-SRL/{{repo}} --title '{{title}}' --body '{{body}}')
    echo "Issue created: $URL"
    ITEM_ID=$(gh project item-add 4 --owner Emotion-SRL --url "$URL" --format json -q .id 2>/dev/null || echo "")
    if [ -n "$ITEM_ID" ]; then
        gh project item-edit --id "$ITEM_ID" --project-id PVT_kwDOBGn_Wc4BZ0Ec \
            --field-id PVTSSF_lADOBGn_Wc4BZ0EczhUwJEU \
            --single-select-option-id f75ad846 2>/dev/null
        echo "Added to SVILUPPO (Backlog). Item ID: $ITEM_ID"
    else
        echo "Warning: issue created but could not add to SVILUPPO."
        echo "Add manually with: just proj-add {{repo}} <issue-number>"
    fi

# List open issues in a specific repo
# Usage: just issue-list server_api
issue-list repo:
    gh issue list --repo Emotion-SRL/{{repo}} --state open

# List all open issues across the org (with repo name)
issue-list-all:
    #!/usr/bin/env bash
    set -euo pipefail
    gh search issues --owner Emotion-SRL --state open \
        --json repository,number,title,updatedAt \
        --jq '.[] | "\(.repository.nameWithOwner)#\(.number)\t\(.title)\t\(.updatedAt[0:10])"' 2>/dev/null \
        | column -t -s $'\t' || echo "(no open issues)"

# View issue details
# Usage: just issue-view server_api 42
issue-view repo num:
    gh issue view {{num}} --repo Emotion-SRL/{{repo}}

# Close an issue
# Usage: just issue-close server_api 42
issue-close repo num:
    gh issue close {{num}} --repo Emotion-SRL/{{repo}}

# Assign an issue to a user
# Usage: just issue-assign server_api 42 FilMar
issue-assign repo num user:
    gh issue edit {{num}} --repo Emotion-SRL/{{repo}} --add-assignee {{user}}

# Add a label to an issue
# Usage: just issue-label server_api 42 bug
issue-label repo num label:
    gh issue edit {{num}} --repo Emotion-SRL/{{repo}} --add-label {{label}}

# Comment on an issue
# Usage: just issue-comment server_api 42 "Working on this"
issue-comment repo num text:
    gh issue comment {{num}} --repo Emotion-SRL/{{repo}} --body '{{text}}'

# === PROJECT SVILUPPO ===

# List all items in SVILUPPO with status, repo, assignee
proj-list:
    gh project item-list 4 --owner Emotion-SRL --format json 2>/dev/null | python3 {{SCRIPTS}}/proj_list.py

# List items filtered by status
# Usage: just proj-by-status "In progress"
proj-by-status status:
    gh project item-list 4 --owner Emotion-SRL --format json 2>/dev/null | python3 {{SCRIPTS}}/proj_by_status.py '{{status}}'

# Shortcut: items in progress
proj-in-progress:
    just proj-by-status "In progress"

# Move an item to a new status
# Usage: just proj-move PVTI_lADOBGn_Wc4BZ0EczgvCCyk "In progress"
proj-move item_id status:
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{status}}" in
        [Bb]acklog)      OPT=f75ad846 ;;
        [Rr]eady)        OPT=61e4505c ;;
        "In progress"|in-progress|[Ii]nprogress) OPT=47fc9ee4 ;;
        [Tt]esting)      OPT=df73e18b ;;
        [Dd]one)         OPT=98236657 ;;
        *) echo "Unknown status: {{status}}"; echo "Valid: Backlog, Ready, In progress, Testing, Done"; exit 1 ;;
    esac
    gh project item-edit --id {{item_id}} --project-id PVT_kwDOBGn_Wc4BZ0Ec \
        --field-id PVTSSF_lADOBGn_Wc4BZ0EczhUwJEU --single-select-option-id "$OPT"
    echo "Moved {{item_id}} to {{status}}"

# Set size on an item
# Usage: just proj-size PVTI_lADOBGn_Wc4BZ0EczgvCCyk M
proj-size item_id size:
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{size}}" in
        [Xx][Ss]) OPT=6c6483d2 ;;
        [Ss])     OPT=f784b110 ;;
        [Mm])     OPT=7515a9f1 ;;
        [Ll])     OPT=817d0097 ;;
        [Xx][Ll]) OPT=db339eb2 ;;
        *) echo "Unknown size: {{size}}"; echo "Valid: XS, S, M, L, XL"; exit 1 ;;
    esac
    gh project item-edit --id {{item_id}} --project-id PVT_kwDOBGn_Wc4BZ0Ec \
        --field-id PVTSSF_lADOBGn_Wc4BZ0EczhUwJRk --single-select-option-id "$OPT"
    echo "Set {{item_id}} size to {{size}}"

# Add an existing issue to SVILUPPO (status defaults to Backlog)
# Usage: just proj-add server_api 42
proj-add repo issue_num:
    #!/usr/bin/env bash
    set -euo pipefail
    URL="https://github.com/Emotion-SRL/{{repo}}/issues/{{issue_num}}"
    ITEM_ID=$(gh project item-add 4 --owner Emotion-SRL --url "$URL" --format json -q .id 2>/dev/null || echo "")
    if [ -n "$ITEM_ID" ]; then
        gh project item-edit --id "$ITEM_ID" --project-id PVT_kwDOBGn_Wc4BZ0Ec \
            --field-id PVTSSF_lADOBGn_Wc4BZ0EczhUwJEU \
            --single-select-option-id f75ad846 2>/dev/null
        echo "Added to SVILUPPO (Backlog). Item ID: $ITEM_ID"
    else
        echo "Error: could not add issue to SVILUPPO."
        echo "Check that issue #{{issue_num}} exists in Emotion-SRL/{{repo}}"
        exit 1
    fi

# === RECAP ===

# Full recap: project status + open PRs + open branches across all repos
recap:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "============================================"
    echo "       SVILUPPO - Project Recap            "
    echo "============================================"
    echo
    echo "--- STATUS BREAKDOWN ---"
    gh project item-list 4 --owner Emotion-SRL --format json 2>/dev/null \
        | python3 {{SCRIPTS}}/recap_status.py
    echo
    echo "--- OPEN PULL REQUESTS ---"
    PRS=$(gh search prs --owner Emotion-SRL --state open \
        --json repository,number,title,author,updatedAt \
        --jq '.[] | "  \(.repository.nameWithOwner)#\(.number)  \(.title)  (@\(.author.login))  \(.updatedAt[0:10])"' 2>/dev/null || true)
    if [ -n "$PRS" ]; then
        echo "$PRS"
    else
        echo "  (no open PRs)"
    fi
    echo
    echo "--- OPEN BRANCHES (excluding main/master) ---"
    FOUND_BRANCH=0
    for repo in $(gh repo list Emotion-SRL --limit 100 --json name -q '.[].name' 2>/dev/null); do
        branches=$(gh api "repos/Emotion-SRL/$repo/branches" --paginate \
            -q '[.[] | select(.name != "main" and .name != "master")] | .[].name' 2>/dev/null || true)
        if [ -n "$branches" ]; then
            FOUND_BRANCH=1
            echo "  $repo:"
            echo "$branches" | sed 's/^/    /'
        fi
    done
    if [ "$FOUND_BRANCH" -eq 0 ]; then
        echo "  (no extra branches)"
    fi

# Open PRs across the org
prs:
    #!/usr/bin/env bash
    set -euo pipefail
    gh search prs --owner Emotion-SRL --state open \
        --json repository,number,title,author,updatedAt \
        --jq '.[] | "\(.repository.nameWithOwner)#\(.number)\t\(.title)\t@\(.author.login)\t\(.updatedAt[0:10])"' 2>/dev/null \
        | column -t -s $'\t' || echo "(no open PRs)"

# Open branches (non-main/master) across all org repos
branches:
    #!/usr/bin/env bash
    set -euo pipefail
    FOUND=0
    for repo in $(gh repo list Emotion-SRL --limit 100 --json name -q '.[].name' 2>/dev/null); do
        branches=$(gh api "repos/Emotion-SRL/$repo/branches" --paginate \
            -q '[.[] | select(.name != "main" and .name != "master")] | .[].name' 2>/dev/null || true)
        if [ -n "$branches" ]; then
            FOUND=1
            echo "  $repo:"
            echo "$branches" | sed 's/^/    /'
        fi
    done
    [ "$FOUND" -eq 0 ] && echo "(no extra branches)"

# List all repos in the org
repos:
    gh repo list Emotion-SRL --limit 100 --json name,visibility,updatedAt \
        --jq '.[] | "\(.name)\t\(.visibility)\t\(.updatedAt[0:10])"' | column -t -s $'\t'

# === ESCAPE HATCH ===

# Pass through to gh directly
# Usage: just raw repo view Emotion-SRL/server_api
raw *args:
    gh {{args}}