# Taskwarrior wrapper for the gtd skill.
# All GTD operations go through these recipes — do not call `task` directly.

default:
    @just --list

# Quick capture: add a task with a description and optional modifiers
# e.g: just add "Buy bread" +errands due:tomorrow
add desc *mods:
    task add '{{desc}}' {{mods}}

# List pending tasks with an optional filter
# e.g: just list, just list project:Home, just list +weekend due.before:eom
list *filter:
    task {{filter}} list

# Most urgent tasks (sorted by urgency)
next:
    task next

# Next actions (tagged +next)
next-actions:
    task +next next

# Inbox — tasks to clarify (no workflow state yet)
inbox:
    task -next -waiting -someday -routine list

# By Area of Focus
emotion:
    task +emotion next
cura:
    task +cura next
amministrazione:
    task +amministrazione next
personale:
    task +personale next
lavoro:
    task +lavoro next

# By energy required
focus:
    task +focus next
exec:
    task +execute exec
reflect:
    task +reflect next
rest:
    task +rest next

# By workflow state
waiting-list:
    task +waiting list
someday:
    task +someday list
routine:
    task +routine list

# Full details of a task (including change history)
info id:
    task {{id}} info

# Complete a task
done id:
    task {{id}} done

# Delete a task
delete id:
    task {{id}} delete

# Start working on a task
start id:
    task {{id}} start

# Stop working on a task
stop id:
    task {{id}} stop

# Generic edit: pass any Taskwarrior modifier
# e.g: just modify 12 due:eom priority:H
modify id *mods:
    task {{id}} modify {{mods}}

# Assign a project to a task
proj id project:
    task {{id}} modify project:'{{project}}'

# Add a tag to a task
tag id tag:
    task {{id}} modify +{{tag}}

# Remove a tag from a task
untag id tag:
    task {{id}} modify -{{tag}}

# Set a task's due date
# e.g: just due 12 tomorrow, just due 12 eom, just due 12 2025-07-15
due id date:
    task {{id}} modify due:{{date}}

# Remove a task's due date
nodue id:
    task {{id}} modify due:

# Set priority (H, M, L, or empty)
prio id level:
    task {{id}} modify priority:{{level}}

# Remove priority
noprio id:
    task {{id}} modify priority:

# Add an annotation to a task
annotate id text:
    task {{id}} annotate '{{text}}'

# List all projects with task counts
projects:
    task projects

# List all tags in use
tags:
    task tags

# Overdue tasks (past their due date)
overdue:
    task +OVERDUE list

# Started tasks (active but not completed)
active:
    task active

# Waiting tasks (wait date in the future)
waiting:
    task +WAITING list

# Completed tasks
completed *filter:
    task {{filter}} completed

# Calendar with due dates
calendar:
    task calendar

# Activate a context
context-set name:
    task context {{name}}

# Deactivate the current context
context-none:
    task context none

# List available contexts
context-list:
    task context list

# Export tasks to JSON (for programmatic processing)
export *filter:
    task {{filter}} export

# Escape hatch: pass any command straight to taskwarrior
# e.g: just raw burndown.weekly, just raw 12 duplicate
raw *args:
    task {{args}}
