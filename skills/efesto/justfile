# Efesto — skill authoring and evaluation recipes.
# This skill wraps its own Python scripts and the agent runner. SKILL.md
# references only these recipes; it never invokes scripts or the runner CLI
# directly.

set fallback := true

SMITH_DIR := justfile_directory()

default:
    @just --list

# Print the skill roster: name and what it does, derived from each SKILL.md frontmatter.
roster:
    @python3 "{{SMITH_DIR}}/scripts/roster.py" "{{SMITH_DIR}}/.."

# Validate a skill folder (SKILL.md frontmatter, required files).
validate skill_path:
    cd "{{SMITH_DIR}}" && python3 -m scripts.quick_validate $(realpath -m "{{invocation_directory()}}/{{skill_path}}")

# Run a skill for real in a throwaway th member, inside the bwrap sandbox (see SKILL.md).
test-skill skill_path task:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{invocation_directory()}}"
    name="efesto-test-$(basename "{{skill_path}}")"
    th member create "$name" --hat white-core --role "tests skill under evaluation" --tools read,bash --tmp
    th run --member "$name" --task "Use the skill at {{skill_path}} to do this: {{task}}. Note: you run inside a bwrap sandbox — only $(pwd), ~/.pi, ~/.bun and /tmp are writable; everything else is read-only by design, not a bug in the skill."
    th member delete "$name"

# Search the public skills-cli registry for existing skills matching a query (research, not install).
search query:
    skills-cli search "{{query}}"

# Show full metadata + SKILL.md content for one registry skill, for research — does not install it.
search-info skill_name:
    skills-cli info {{skill_name}}

# Package a skill into a distributable .skill file.
package skill_path output_dir=".":
    cd "{{SMITH_DIR}}" && python3 -m scripts.package_skill "{{invocation_directory()}}/{{skill_path}}" "{{invocation_directory()}}/{{output_dir}}"

# Lint one skill: SKILL.md `just` invocations vs justfile signatures, guard presence.
lint skill_path:
    python3 "{{justfile_directory()}}/scripts/lint_skill.py" "{{skill_path}}"

# Lint every skill in a directory (default: the repo's skills/).
lint-all dir=(justfile_directory() / ".."):
    #!/usr/bin/env bash
    set -euo pipefail
    dirs=()
    for d in "{{dir}}"/*/; do
        [ -f "$d/SKILL.md" ] && dirs+=("$d")
    done
    python3 "{{justfile_directory()}}/scripts/lint_skill.py" "${dirs[@]}"
