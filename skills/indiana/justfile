# Indiana — code archaeology recipes.
# This skill wraps common filesystem inspection commands. SKILL.md references
# only these recipes; it never invokes commands directly.

default:
    @just --list

# List files under a path up to a given depth.
files path maxdepth="2":
    find {{path}} -maxdepth {{maxdepth}} -type f | sort

# List directories under a path up to a given depth.
dirs path maxdepth="3":
    find {{path}} -maxdepth {{maxdepth}} -type d | sort

# Count source files and test files under a path (excludes node_modules/.git).
counts path:
    #!/usr/bin/env bash
    set -euo pipefail
    src=$(find {{path}} -type f \( -name "*.py" -o -name "*.ts" -o -name "*.js" -o -name "*.go" -o -name "*.rs" \) | grep -v node_modules | grep -v ".git" | wc -l)
    tests=$(find {{path}} -name "*.test.*" -o -name "*_test.*" -o -name "*spec*" | grep -v node_modules | wc -l)
    echo "source: $src  tests: $tests"

# Largest source files (God-object signal).
giants path:
    find {{path}} -name "*.py" -o -name "*.ts" -o -name "*.go" -o -name "*.js" -o -name "*.rs" | grep -v node_modules | xargs wc -l 2>/dev/null | sort -rn | head -15

# Most modified files from git history (hotspots).
hotspots path:
    git -C {{path}} log --format=format: --name-only | grep -v "^$" | sort | uniq -c | sort -rn | head -15

# Pain comments in source code.
pain path:
    grep -rn "TODO\|FIXME\|HACK\|XXX\|workaround\|kludge\|hotfix" {{path}} --include="*.py" --include="*.ts" --include="*.go" --include="*.js" 2>/dev/null | grep -v node_modules | head -30

# Search the Third Brain for what is known about a technology/stack.
tb-search query *FLAGS:
    tb search "{{query}}" {{FLAGS}}
