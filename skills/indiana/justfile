# Indiana — code archaeology recipes.
# This skill wraps common filesystem inspection commands. SKILL.md references
# only these recipes; it never invokes commands directly.
#
# Positional args only. Recipes start with scripts/guard.sh, which rejects
# flag-style (--x) and NAME=value invocations: just would silently map them
# into positional slots and corrupt the call.

set positional-arguments

guard := justfile_directory() / "scripts/guard.sh"

default:
    @just --list

# List files under a path. Usage: just files <path> [maxdepth] ["<glob>"]
[no-cd]
files path maxdepth="2" pattern="*":
    @"{{guard}}" "Usage: just files <path> [maxdepth] ['<glob>']" "$@"
    @find "$1" -maxdepth "$2" -type f -name "$3" | sort

# List directories under a path. Usage: just dirs <path> [maxdepth]
[no-cd]
dirs path maxdepth="3":
    @"{{guard}}" 'Usage: just dirs <path> [maxdepth]' "$@"
    @find "$1" -maxdepth "$2" -type d | sort

# Count source files and test files under a path (excludes node_modules/.git).
[no-cd]
counts path:
    #!/usr/bin/env bash
    set -euo pipefail
    "{{guard}}" 'Usage: just counts <path>' "$@"
    src=$(find "$1" -type f \( -name "*.py" -o -name "*.ts" -o -name "*.js" -o -name "*.go" -o -name "*.rs" \) | grep -v node_modules | grep -v ".git" | wc -l)
    tests=$(find "$1" -name "*.test.*" -o -name "*_test.*" -o -name "*spec*" | grep -v node_modules | wc -l)
    echo "source: $src  tests: $tests"

# Largest source files (God-object signal). Usage: just giants <path>
[no-cd]
giants path:
    @"{{guard}}" 'Usage: just giants <path>' "$@"
    @find "$1" -name "*.py" -o -name "*.ts" -o -name "*.go" -o -name "*.js" -o -name "*.rs" | grep -v node_modules | xargs wc -l 2>/dev/null | sort -rn | head -15

# Most modified files from git history (hotspots). Usage: just hotspots <path>
[no-cd]
hotspots path:
    @"{{guard}}" 'Usage: just hotspots <path>' "$@"
    @git -C "$1" log --format=format: --name-only | grep -v "^$" | sort | uniq -c | sort -rn | head -15

# Pain comments in source code. Usage: just pain <path>
[no-cd]
pain path:
    @"{{guard}}" 'Usage: just pain <path>' "$@"
    @grep -rn "TODO\|FIXME\|HACK\|XXX\|workaround\|kludge\|hotfix" "$1" --include="*.py" --include="*.ts" --include="*.go" --include="*.js" 2>/dev/null | grep -v node_modules | head -30

# Search the Third Brain for what is known about a technology/stack. Usage: just tb-search "<query>" [limit]
tb-search query limit="5":
    @"{{guard}}" 'Usage: just tb-search "<query>" [limit]' "$@"
    @tb search "$1" --limit "$2"
