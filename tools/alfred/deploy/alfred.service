# alfred serve, as a user unit. filcloud_init (services/alfred) links and starts it.
# The defaults fit the server: vault ~/notes, hist ~/.tl/tl.db (the tl archive),
# Qdrant and Ollama on localhost, port 8791, distill trigger off.
# Override one in a drop-in, for example ALFRED_DISTILL_TRIGGER=on at the switch.

[Unit]
Description=alfred serve
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/alfred serve
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
